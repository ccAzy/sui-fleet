# 依赖与构建产物（开源仓库只放源码）
node_modules/
.wrangler/
dist/
*.log

# 本地运行时数据
db/
*.db
*.db-shm
*.db-wal

# 编辑器
.DS_Store
.idea/
.vscode/
.tmp/

# 本地真实配置（含 database_id / 域名，绝不入库）
panel/wrangler.local.toml
panel/.dev.vars

# 本地备份
*.bak
*.bak-*
*.before-*

# 本地验证截图
shots/

# 新建节点时的一次性凭据清单，含 agent token，不入库
panel/newnodes.json

# 临时分发目录（大二进制分片，装完即删，不入库）
panel/frontend-dist/dl/

# 真实部署配置（含真实域名与 KV id）
apps/*/wrangler.local.toml
