{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.vue",
      "**/*.json",
      "!**/node_modules",
      "!**/dist",
      "!**/frontend-dist",
      "!**/.wrangler",
      "!**/locales",
      "!**/package-lock.json"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "warn",
        "noDoubleEquals": "off",
        "useIterableCallbackReturn": "warn",
        "noAssignInExpressions": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useTemplate": "off",
        "useImportType": "off",
        "useVueMultiWordComponentNames": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useOptionalChain": "off",
        "useMathMinMax": "off",
        "useLiteralKeys": "off",
        "noBannedTypes": "warn"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnsafeOptionalChaining": "warn",
        "noUnusedFunctionParameters": "warn"
      },
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": [
        "**/*.vue"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}