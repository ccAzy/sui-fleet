// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`转换输出的特征化快照 > Clash 全协议配置 1`] = `
"# snapshot
# generated by s-ui cloud panel
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
external-controller: "127.0.0.1:9090"
proxies:
  - name: vless-reality
    type: vless
    server: 1.2.3.4
    port: 443
    uuid: 11111111-2222-3333-4444-555555555555
    udp: true
    tls: true
    client-fingerprint: chrome
    reality-opts:
      public-key: TrsKws6hJseeVGwMIqUtY9z_uZLwUpmBC_nX9DgRrBc
      short-id: 84223ca3
    servername: www.apple.com
    flow: xtls-rprx-vision
    network: tcp
  - name: vless-ws
    type: vless
    server: 1.2.3.4
    port: 8443
    uuid: 11111111-2222-3333-4444-555555555555
    udp: true
    tls: true
    servername: example.com
    network: ws
    ws-opts:
      path: /ws
      headers:
        Host: example.com
  - name: vless-grpc
    type: vless
    server: 1.2.3.4
    port: 9443
    uuid: 11111111-2222-3333-4444-555555555555
    udp: true
    tls: true
    servername: example.com
    network: grpc
    grpc-opts:
      grpc-service-name: grpc
  - name: vmess-ws
    type: vmess
    server: 5.5.5.5
    port: 443
    uuid: 11111111-2222-3333-4444-555555555555
    alterId: 0
    cipher: auto
    udp: true
    tls: true
    servername: example.com
    network: ws
    ws-opts:
      path: /vm
      headers:
        Host: example.com
  - name: trojan
    type: trojan
    server: 6.6.6.6
    port: 443
    password: password123
    udp: true
    sni: example.com
    skip-cert-verify: true
    network: tcp
  - name: ss
    type: ss
    server: 5.6.7.8
    port: 8388
    cipher: aes-256-gcm
    password: password
    udp: true
  - name: ss2022
    type: ss
    server: 5.6.7.8
    port: 8389
    cipher: 2022-blake3-aes-256-gcm
    password: password
    udp: true
  - name: hy2
    type: hysteria2
    server: 9.9.9.9
    port: 443
    password: pass
    udp: true
    sni: www.bing.com
    skip-cert-verify: true
  - name: tuic
    type: tuic
    server: 9.9.9.9
    port: 8443
    uuid: 11111111-2222-3333-4444-555555555555
    password: pw
    udp: true
    sni: example.com
    alpn:
      - h3
    congestion-controller: bbr
    skip-cert-verify: true
  - name: anytls
    type: anytls
    server: 9.9.9.9
    port: 8444
    password: pw
    udp: true
    sni: example.com
    skip-cert-verify: true
  - name: socks5
    type: socks5
    server: 7.7.7.7
    port: 1080
    udp: true
    username: user
    password: pass
    network: tcp
proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - vless-reality
      - vless-ws
      - vless-grpc
      - vmess-ws
      - trojan
      - ss
      - ss2022
      - hy2
      - tuic
      - anytls
      - socks5
      - DIRECT
  - name: AUTO
    type: url-test
    proxies:
      - vless-reality
      - vless-ws
      - vless-grpc
      - vmess-ws
      - trojan
      - ss
      - ss2022
      - hy2
      - tuic
      - anytls
      - socks5
    url: "https://www.gstatic.com/generate_204"
    interval: 300
rules:
  - "GEOIP,CN,DIRECT"
  - "MATCH,PROXY"
"
`;

exports[`转换输出的特征化快照 > sing-box 全协议配置 1`] = `
