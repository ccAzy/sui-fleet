+const agentPendingTrafficKey = "agent_pending_traffic"
+const agentCoreSigKey = "agent_core_sig"
+
+// 单次上报的流量条目上限（面板侧也有限制；这里先截，避免请求体无界）。
+const maxTrafficEntries = 5000
+
+func loadPendingTraffic() map[string]*trafficDelta {
+	out := map[string]*trafficDelta{}
+	var s model.Setting
+	if err := database.GetDB().Where("key = ?", agentPendingTrafficKey).First(&s).Error; err != nil {
+		return out
+	}
+	var list []trafficDelta
+	if err := json.Unmarshal([]byte(s.Value), &list); err != nil {
+		return out
+	}
+	for _, d := range list {
+		if d.Tag == "" {
+			continue
+		}
+		acc, ok := out[d.Tag]
+		if !ok {
+			acc = &trafficDelta{Tag: d.Tag}
+			out[d.Tag] = acc
+		}
+		acc.Up += d.Up
+		acc.Down += d.Down
+	}
+	return out
+}
+
+func savePendingTraffic(m map[string]*trafficDelta) {
+	list := make([]trafficDelta, 0, len(m))
+	for _, d := range m {
+		if d.Up == 0 && d.Down == 0 {
+			continue
+		}
+		list = append(list, *d)
+	}
+	raw, err := json.Marshal(list)
+	if err != nil {
+		return
+	}
+	db := database.GetDB()
+	var s model.Setting
+	if err := db.Where("key = ?", agentPendingTrafficKey).First(&s).Error; err != nil {
+		_ = db.Create(&model.Setting{Key: agentPendingTrafficKey, Value: string(raw)}).Error
+		return
+	}
+	_ = db.Model(&model.Setting{}).Where("key = ?", agentPendingTrafficKey).Update("value", string(raw)).Error
+}
+
+// absorbTraffic 把本轮从内核取到的增量并进待上报集合（按 tag 累加）。
+func (a *agent) absorbTraffic(list []trafficDelta) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.pending == nil {
+		a.pending = map[string]*trafficDelta{}
+	}
+	for _, d := range list {
+		if d.Tag == "" {
+			continue
+		}
+		acc, ok := a.pending[d.Tag]
+		if !ok {
+			acc = &trafficDelta{Tag: d.Tag}
+			a.pending[d.Tag] = acc
+		}
+		acc.Up += d.Up
+		acc.Down += d.Down
+	}
+}
+
+// snapshotTraffic 取一份可用于上报的拷贝（不清空）。
+func (a *agent) snapshotTraffic() []trafficDelta {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	out := make([]trafficDelta, 0, len(a.pending))
+	for _, d := range a.pending {
+		if d.Up == 0 && d.Down == 0 {
+			continue
+		}
+		out = append(out, *d)
+		if len(out) >= maxTrafficEntries {
+			break
+		}
+	}
+	return out
+}
+
+// clearTraffic 只在面板确实收下（2xx）之后调用。
+func (a *agent) clearTraffic() {
+	a.mu.Lock()
+	a.pending = map[string]*trafficDelta{}
+	a.mu.Unlock()
+	savePendingTraffic(map[string]*trafficDelta{})
+}
+
+// coreConfigSig 只覆盖「内核配置」：settings 变化不需要重启 sing-box。
+func coreConfigSig(pr *agentPullResp) string {
+	h := sha256.New()
+	h.Write(pr.Config)
+	h.Write([]byte{0})
+	for _, group := range [][]json.RawMessage{pr.TLS, pr.Inbounds, pr.Outbounds, pr.Endpoints, pr.Services} {
+		for _, b := range group {
+			h.Write(b)
+			h.Write([]byte{0})
+		}
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+func loadCoreSig() string {
+	var s model.Setting
+	if err := database.GetDB().Where("key = ?", agentCoreSigKey).First(&s).Error; err != nil {
+		return ""
+	}
+	return s.Value
+}
+
+func saveCoreSig(sig string) {
+	db := database.GetDB()
+	var s model.Setting
+	if err := db.Where("key = ?", agentCoreSigKey).First(&s).Error; err != nil {
+		_ = db.Create(&model.Setting{Key: agentCoreSigKey, Value: sig}).Error
+		return
+	}
+	_ = db.Model(&model.Setting{}).Where("key = ?", agentCoreSigKey).Update("value", sig).Error
+}
+
