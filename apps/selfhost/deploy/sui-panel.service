# 控制面服务单元（放在主控机上：/etc/systemd/system/sui-panel.service）
# 安装：
#   cp -r apps/selfhost /opt/sui-panel/apps/selfhost
#   cp -r panel/frontend-dist /opt/sui-panel/frontend-dist
#   install -m600 /dev/stdin /etc/sui-panel.env <<< 'JWT_SECRET=...'
#   systemctl daemon-reload && systemctl enable --now sui-panel
[Unit]
Description=s-ui Cloud 控制面（自托管）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 生产用 sui 用户跑（/opt/sui-panel/data 属主 sui，目录 0750、库 0600）
User=sui
Group=sui
WorkingDirectory=/opt/sui-panel/apps/selfhost
EnvironmentFile=/etc/sui-panel.env
Environment=SUI_DB=/opt/sui-panel/data/sui.db
Environment=SUI_DIST=/opt/sui-panel/frontend-dist
Environment=PORT=8788
# 注意不要在这里写死 PANEL_BASE：单元里的 Environment= 会覆盖 EnvironmentFile，
# 于是改 /etc/sui-panel.env 变得无效（生产上真踩过：写死成已下线的域名，
# 防脑裂 epoch 闸门一直在问一个不存在的地址）。
# 同理 SUI_PANEL_HOST 默认 127.0.0.1（只给本机 Caddy 反代），需要局域网访问才设。
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
# 控制面要读整库并渲染配置，句柄给足
LimitNOFILE=65535

# 基础加固：只写自己的数据目录，家目录与系统目录只读
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sui-panel/data

[Install]
WantedBy=multi-user.target
